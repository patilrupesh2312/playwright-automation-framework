{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Playwright automation framework for UI and API testing",
  "main": "index.js",
  "scripts": {
  "typecheck": "tsc --noEmit",
  "test": "playwright test",
  "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
  "test:ui:chromium": "playwright test --project=ui-chromium",
  "test:ui:headed": "playwright test --project=ui-chromium --headed",
  "test:ui:debug": "playwright test --project=ui-chromium --debug",
  "test:api": "playwright test --project=api",
  "report": "playwright show-report"
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patilrupesh2312/playwright-automation-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/patilrupesh2312/playwright-automation-framework/issues"
  },
  "homepage": "https://github.com/patilrupesh2312/playwright-automation-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
